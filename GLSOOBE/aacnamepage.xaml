<Page x:Class="GLSOOBE.aacnamepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GLSOOBE"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="aacnamepage">

    <Grid Width="800">
        <Grid.Background>
            <ImageBrush ImageSource="Aroura.JPG"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="20.289,34.233,0,0" TextWrapping="Wrap" Text="Name the new account" VerticalAlignment="Top" Height="36.103" Width="331.99" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock HorizontalAlignment="Left" Margin="20.289,100.773,0,0" TextWrapping="Wrap" Text="The name you type will appear on the Welcome screen and the Start menu. After typing the name that you want to add, click Create Account. The name you type here will be a system administrator." VerticalAlignment="Top" Foreground="White" Width="734" FontSize="14"/>
        <Button x:Name="createaccount" Content="Create Account" HorizontalAlignment="Left" Height="26" Margin="237,140.5,0,0" VerticalAlignment="Top" Width="133.833" Click="createaccount_Click"/>
        <Button x:Name="backbutton" Content="Back" HorizontalAlignment="Left" Height="25" Margin="530,555,0,0" VerticalAlignment="Top" Width="110.5" Click="Button_Click"/>
        <TextBox x:Name="usernameinput" HorizontalAlignment="Left" Height="26" Margin="20.289,140.5,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="205.711"/>
        <Button x:Name="newnext" Content="Next" HorizontalAlignment="Left" Height="25.05" Margin="660.5,554.95,0,0" VerticalAlignment="Top" Width="110.5" Click="newnext_Click"/>
    </Grid>
</Page>
