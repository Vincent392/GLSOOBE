<Page x:Class="GLSOOBE.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GLSOOBE"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Title="WelcomePage">
    <Page.Background>
        <ImageBrush ImageSource="Aroura.JPG"/>
    </Page.Background>

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.Background>
            <ImageBrush/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="20.289,34.233,0,0" TextWrapping="Wrap" Text="Welcome to Windows Setup" VerticalAlignment="Top" Height="36.103" Width="491" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock HorizontalAlignment="Left" Margin="20.289,96.273,0,0" TextWrapping="Wrap" Text="We'll ask you a few questions before getting started. To continue, click Next." VerticalAlignment="Top" Foreground="White" Width="491" FontSize="14"/>
        <Button Content="Next" HorizontalAlignment="Stretch" Height="25" Margin="663,555,26.5,20" VerticalAlignment="Stretch" Width="110.5" Click="Button_Click"/>

    </Grid>
</Page>
